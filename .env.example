# Canonical PostgreSQL database.
# Default matches docker compose in this repo.
CDP_DATABASE_URL=postgresql://cdp:cdp@127.0.0.1:5432/cdp

# Public synthetic JSONL seed. Never point this at private business files
# in a commit or CI job.
CDP_DATA=./sample_data

# Optional override for pytest (created automatically if missing).
CDP_TEST_DATABASE_URL=postgresql://cdp:cdp@127.0.0.1:5432/cdp_test

# Optional. Freeze relative dates / listing ages.
# Default: sample_data/world.json when present.
# CDP_AS_OF=now uses the wall clock.
# CDP_AS_OF=2026-09-09T12:00:00Z sets an explicit instant.
# CDP_LLM_PROVIDER=fake
# CDP_LLM_API_KEY=
# CDP_LLM_BASE_URL=https://api.openai.com/v1
# CDP_LLM_MODEL=gpt-4o-mini
