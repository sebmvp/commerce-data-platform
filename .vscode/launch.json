{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "cdp_cli.api.main:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "CDP_DATABASE_URL": "postgresql://cdp:cdp@127.0.0.1:5432/cdp"
      }
    }
  ]
}
